{
  "manifest_version": 3,
  "name": "SUAP Tools",
  "version": "0.9.0",
  "description": "Ferramentas para o SUAP. Importação de notas e aulas; edição e exclusão com prévia e confirmação.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://suap.ifba.edu.br/*"
  ],
  "action": {
    "default_title": "SUAP Tools",
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suap.ifba.edu.br/*"
      ],
      "js": [
        "suap-grade-parser.js",
        "suap-class-parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "assets/*"
      ],
      "matches": [
        "https://suap.ifba.edu.br/*"
      ]
    }
  ]
}
