{
  "manifest_version": 3,
  "name": "SUAP Tools",
  "version": "0.4.0",
  "description": "Ferramentas para o SUAP. Leitura de notas e aulas, importação padronizada e envio automático opcional de aulas.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://suap.ifba.edu.br/*"
  ],
  "action": {
    "default_title": "SUAP Tools",
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suap.ifba.edu.br/*"
      ],
      "js": [
        "suap-grade-parser.js",
        "suap-class-parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
